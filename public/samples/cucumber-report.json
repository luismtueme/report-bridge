        "tags": [{ "name": "@smoke" }],
        "steps": [
          {
            "keyword": "Given ",
            "name": "the catalog contains SKU \"SKU-1044\"",
            "result": { "status": "passed", "duration": 50000000 }
          },
          {
            "keyword": "When ",
            "name": "the shopper searches for \"SKU-1044\"",
            "result": { "status": "passed", "duration": 300000000 }
          },
          {
            "keyword": "Then ",
