{
  "name": "reportbridge",
  "version": "0.1.0",
  "private": false,
  "description": "Import test automation results into a shared IR and preview Cucumber-style, Allure-like, and Extent-like reports.",
  "license": "MIT",
  "author": "Luis Alberto Morales Tueme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luismtueme/report-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/luismtueme/report-bridge/issues"
  },
  "homepage": "https://github.com/luismtueme/report-bridge#readme",
  "keywords": [
    "test-reporting",
    "allure",
    "cucumber",
    "playwright",
    "jest",
    "junit",
    "pytest",
    "mcp",
    "intermediate-representation"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mcp": "tsx src/mcp/server.ts",
    "test:imports": "tsx scripts/verify-imports.ts",
    "generate:real-reports": "bash tools/real-reports/generate.sh"
  },
  "bin": {
    "reportbridge-mcp": "./src/mcp/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fast-xml-parser": "^5.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.0"
  }
}
